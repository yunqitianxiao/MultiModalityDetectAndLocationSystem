<?xml version="1.0"?>
<!--
  隧道病害巡检仿真世界
  - 简易矩形隧道走廊: 左墙 + 右墙 + 顶板, 净宽 ~2.5m, 净高 ~2.75m
  - 走廊内放置红/绿/蓝色块与圆柱, 为相机、16线雷达提供丰富特征(供后续 SLAM / 病害检测)
  - 注: 地面与阳光显式定义, 不依赖 model:// 资源路径
-->
<sdf version="1.9">
  <world name="tunnel_world">

    <physics name="default_physics" default="true" type="dart">
      <gravity>0 0 -9.8</gravity>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6</ambient>
      <background>0.2 0.2 0.2</background>
      <shadows>true</shadows>
    </scene>

    <!-- 传感器系统(Harmonic 必需): 统一创建并运行相机/激光雷达/IMU 等所有传感器
         机器人 URDF 里的 <sensor> 即由本系统接管, 无需每个传感器单独声明插件 -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 关键: world 有 Sensors 等系统插件时, gz-sim 不再自动加载默认系统集(含 Physics)。
         必须显式加 physics-system, 否则物理引擎不创建、实体静止、DiffDrive 永不发 odom。 -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

    <!-- 太阳(方向光) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.35 0.35 0.35</diffuse>
      <specular>0.05 0.05 0.05</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 隧道内点光源: 沿隧道每 10m 一盏(z=2.4, range 16)。
         封闭隧道顶挡住太阳直射, 仅靠 scene ambient 会让墙面均匀灰、病害贴图看不清
         (v11-v13t 对比度 std 掉到 10~29 的根源)。点光源制造亮池+暗缝,
         病害 PBR 贴图才能看清。v9/v10 有这组灯, std≈40。 -->
    <light type="point" name="tunnel_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>-15 0 2.4 0 0 0</pose>
      <diffuse>0.5 0.5 0.5</diffuse>
      <specular>0.05 0.05 0.05</specular>
      <attenuation>
        <range>16</range>
        <constant>1.0</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <intensity>1.0</intensity>
    </light>
    <light type="point" name="tunnel_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>-5 0 2.4 0 0 0</pose>
      <diffuse>0.5 0.5 0.5</diffuse>
      <specular>0.05 0.05 0.05</specular>
      <attenuation>
        <range>16</range>
        <constant>1.0</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <intensity>1.0</intensity>
    </light>
    <light type="point" name="tunnel_light_3">
      <cast_shadows>false</cast_shadows>
      <pose>5 0 2.4 0 0 0</pose>
      <diffuse>0.5 0.5 0.5</diffuse>
      <specular>0.05 0.05 0.05</specular>
      <attenuation>
        <range>16</range>
        <constant>1.0</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <intensity>1.0</intensity>
    </light>
    <light type="point" name="tunnel_light_4">
      <cast_shadows>false</cast_shadows>
      <pose>15 0 2.4 0 0 0</pose>
      <diffuse>0.5 0.5 0.5</diffuse>
      <specular>0.05 0.05 0.05</specular>
      <attenuation>
        <range>16</range>
        <constant>1.0</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <intensity>1.0</intensity>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
  <diffuse>0.50 0.50 0.50 1</diffuse>
  <emissive>0.08 0.08 0.08 1</emissive><ambient>0.5 0.5 0.5</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ============ 隧道左墙 ============ -->
    <model name="tunnel_left_wall">
      <static>true</static>
      <pose>0 1.4 1.5 0 0 0</pose>
      <link name="wall">
        <visual name="wall_visual">
          <geometry><box><size>40 0.3 3</size></box></geometry>
          <material>
  <diffuse>0.55 0.55 0.58 1</diffuse>
  <emissive>0.09 0.09 0.09 1</emissive><ambient>0.55 0.55 0.58</ambient></material>
        </visual>
        <collision name="wall_collision">
          <geometry><box><size>40 0.3 3</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 隧道右墙 ============ -->
    <model name="tunnel_right_wall">
      <static>true</static>
      <pose>0 -1.4 1.5 0 0 0</pose>
      <link name="wall">
        <visual name="wall_visual">
          <geometry><box><size>40 0.3 3</size></box></geometry>
          <material>
  <diffuse>0.55 0.55 0.58 1</diffuse>
  <emissive>0.09 0.09 0.09 1</emissive><ambient>0.55 0.55 0.58</ambient></material>
        </visual>
        <collision name="wall_collision">
          <geometry><box><size>40 0.3 3</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 隧道顶板 (拱顶近似) ============ -->
    <model name="tunnel_ceiling">
      <static>true</static>
      <pose>0 0 2.9 0 0 0</pose>
      <link name="ceiling">
        <visual name="ceiling_visual">
          <geometry><box><size>40 3 0.3</size></box></geometry>
          <material>
  <diffuse>0.50 0.50 0.52 1</diffuse>
  <emissive>0.08 0.08 0.08 1</emissive><ambient>0.5 0.5 0.52</ambient></material>
        </visual>
        <collision name="ceiling_collision">
          <geometry><box><size>40 3 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 钢轨 (轨道病害载体, 标准轨距 1435mm, 轨顶 z≈0.15) ============ -->
    <model name="rail_left">
      <static>true</static>
      <pose>0 0.717 0.075 0 0 0</pose>
      <link name="rail">
        <visual name="visual">
          <geometry><box><size>40 0.09 0.15</size></box></geometry>
          <material>
            <diffuse>0.72 0.72 0.75 1</diffuse>
            <emissive>0.12 0.12 0.12 1</emissive>
            <ambient>0.72 0.72 0.75</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>40 0.09 0.15</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="rail_right">
      <static>true</static>
      <pose>0 -0.717 0.075 0 0 0</pose>
      <link name="rail">
        <visual name="visual">
          <geometry><box><size>40 0.09 0.15</size></box></geometry>
          <material>
            <diffuse>0.72 0.72 0.75 1</diffuse>
            <emissive>0.12 0.12 0.12 1</emissive>
            <ambient>0.72 0.72 0.75</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>40 0.09 0.15</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============ 隧道端墙 (封住 x=±20 开口, 避免相机看到隧道外天空致盲白屏) ============ -->
    <model name="tunnel_end_wall_far">
      <static>true</static>
      <pose>20 0 3.5 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>0.4 12 9</size></box></geometry>
          <material>
            <diffuse>0.35 0.35 0.37 1</diffuse>
            <emissive>0.06 0.06 0.06 1</emissive>
            <ambient>0.35 0.35 0.37</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.4 12 9</size></box></geometry>
        </collision>
      </link>
    </model>
    <model name="tunnel_end_wall_near">
      <static>true</static>
      <pose>-20 0 3.5 0 0 0</pose>
      <link name="wall">
        <visual name="visual">
          <geometry><box><size>0.4 12 9</size></box></geometry>
          <material>
            <diffuse>0.35 0.35 0.37 1</diffuse>
            <emissive>0.06 0.06 0.06 1</emissive>
            <ambient>0.35 0.35 0.37</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.4 12 9</size></box></geometry>
        </collision>
      </link>
    </model>

        <!-- ============ 病害模型 (配对数据自动标注真值) ============ -->
