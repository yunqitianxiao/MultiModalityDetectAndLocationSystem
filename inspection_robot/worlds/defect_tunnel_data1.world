      <static>true</static>
      <pose>14.153 1.25 0.87 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <laser_retro>500</laser_retro>
          <geometry><box><size>0.407 0.02 0.385</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <emissive>0.05 0.05 0.05 1</emissive>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr>
              <metal>
                <albedo_map>file:///home/ylf/workspace/inspection_robot/data_gen/textures_data1/crack_8.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name='collision'>
          <geometry><box><size>0.407 0.02 0.385</size></box></geometry>
        </collision>
      </link>
    </model>

